# ═══════════════════════════════════════════════════════════════════════════
#  ISA — Serveur vocal local du Niger : configuration
#  Copiez ce fichier vers `.env` puis ajustez. AUCUNE valeur n'est obligatoire.
#  Commande : cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Réseau ───────────────────────────────────────────────────────────────────
# 0.0.0.0 = joignable par les téléphones du même réseau (bureau, kiosque).
ISA_HOST=0.0.0.0
ISA_PORT=8787
# Origines autorisées pour le site web (séparées par des virgules).
# Laissez « * » en réseau local ; restreignez en production publique :
# ISA_CORS_ORIGINS=https://www.excellence-services-sarl.com
ISA_CORS_ORIGINS=*
# Clé partagée optionnelle : si elle est définie, chaque requête doit envoyer
# l'en-tête X-ISA-Key. À activer dès que le serveur est exposé hors du LAN.
ISA_API_KEY=

# ── Reconnaissance vocale (Whisper) ──────────────────────────────────────────
# tiny | base | small | medium | large-v3
#   tiny/base : 1-2 Go de RAM, très rapide, français correct, haoussa limité
#   small     : 4 Go de RAM, bon compromis (recommandé pour démarrer)
#   medium    : 8 Go de RAM, meilleur haoussa
ISA_STT_MODEL=small
ISA_STT_DEVICE=auto
ISA_STT_COMPUTE=int8
ISA_STT_BEAM=5
ISA_STT_MAX_SECONDS=60
ISA_STT_LANGUAGES=fr,ha,dje,en

# ── Synthèse vocale ──────────────────────────────────────────────────────────
# Voix Piper (français / anglais) — téléchargées par scripts/download_models.py
ISA_TTS_FR=fr_FR-siwis-medium
ISA_TTS_EN=en_US-lessac-medium
ISA_TTS_PIPER_DIR=models/piper
# Voix Meta MMS-TTS pour les langues nationales (aucune alternative gratuite)
ISA_TTS_DJE=facebook/mms-tts-dje
ISA_TTS_HAU=facebook/mms-tts-hau
ISA_TTS_FRA=facebook/mms-tts-fra
ISA_TTS_RATE=22050
ISA_TTS_MAX_CHARS=1200
# Si la voix zarma n'est pas encore téléchargée : traduire puis parler français
# plutôt que rester muet (nécessite Ollama pour la traduction).
ISA_TTS_BRIDGE=1

# ── Modèle de langage local (Ollama) ─────────────────────────────────────────
ISA_OLLAMA_URL=http://127.0.0.1:11434
# 4 Go RAM → qwen2.5:1.5b · 8 Go RAM → llama3.2:3b · 16 Go/GPU → qwen2.5:7b-instruct
ISA_OLLAMA_MODEL=llama3.2:3b
ISA_LLAMACPP_URL=
ISA_LLM_TIMEOUT=45
ISA_LLM_MAX_TOKENS=320
ISA_LLM_TEMPERATURE=0.3

# ── Cartes & météo (services gratuits, sans clé API) ─────────────────────────
ISA_GEO=1
ISA_NOMINATIM_URL=https://nominatim.openstreetmap.org
ISA_OSRM_URL=https://router.project-osrm.org
ISA_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
ISA_OPEN_METEO_GEOCODE=https://geocoding-api.open-meteo.com/v1/search
ISA_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
ISA_GEO_UA=ISA-Niger-VoiceAssistant/1.0 (excellence-services-sarl.com; contact: admin@excellence-services-sarl.com)
ISA_GEO_CACHE=600

# ── Passerelles SMS / WhatsApp (phase 2) ─────────────────────────────────────
# Sans ces réglages, ISA ouvre l'app SMS/WhatsApp du téléphone (liens sms: et
# wa.me) — ce qui fonctionne déjà sur tous les mobiles, sans abonnement.
ISA_SMS_URL=
ISA_SMS_TOKEN=
ISA_WHATSAPP_WEBHOOK=

# ── Mot de réveil (« Isa ! ») ────────────────────────────────────────────────
# Veille mains libres côté serveur (nécessaire pour le zarma/haoussa, que les
# navigateurs ne transcrivent pas). Voir scripts/wake_word_daemon.py.
ISA_WAKE=0
ISA_WAKE_WORDS=isa,issa,yisa,isa isa,ok isa
ISA_WAKE_LISTEN_SECONDS=2.5

# ── Divers ───────────────────────────────────────────────────────────────────
ISA_MODELS_DIR=models
ISA_LOG_LEVEL=INFO
